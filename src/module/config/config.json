{
  "module": {
    "name": "SSHCustom-VPNChain",
    "work_dir": "/data/adb/sshcustom-vpnchain",
    "log_dir": "/data/adb/sshcustom-vpnchain/run",
    "manual_start": true
  },
  "api": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 9190
  },
  "dns": {
    "enabled": false,
    "mode": "device",
    "hijack": false,
    "doh": false,
    "servers": [],
    "timeout_seconds": 4,
    "note": "Device DNS is default. tun2proxy --dns virtual handles DNS through the tunnel automatically."
  },
  "transport": {
    "supported_modes": ["direct","http_proxy","tls_sni","http_proxy_tls_sni"],
    "payload_is_core_feature": true
  },
  "local_proxy": {
    "socks_enabled": true,
    "socks_host": "127.0.0.1",
    "socks_port": 1080
  },
  "tunnel": {
    "enabled": true,
    "mode": "tun2proxy",
    "udpgw_port": 7300
  },
  "hotspot": {
    "enabled": true,
    "tcp": true,
    "dns": false,
    "interfaces": ["wlan+","swlan+","ap+","rndis+","ncm+","bt-pan+"]
  },
  "performance": {
    "buffer_size": 262144,
    "connect_timeout_seconds": 25,
    "keepalive_seconds": 10,
    "retry_initial_delay_seconds": 3,
    "retry_max_delay_seconds": 30,
    "read_probe_timeout_seconds": 10,
    "ssh_pool_size": 2,
    "max_streams_per_ssh": 128,
    "verbose_transparent_logs": false,
    "stream_idle_timeout_seconds": 600,
    "stream_acquire_timeout_seconds": 12
  }
}
