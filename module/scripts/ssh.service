#!/system/bin/sh
# ssh.service — SSHCustom service lifecycle manager
# Modeled after boxproxy/box scripts/box.service
#
# Usage: ssh.service {start|stop|restart|status}

scripts_dir="${0%/*}"
. /data/adb/sshcustom/settings.ini

BIN="${bin_dir}/sshcustomd"
SETTINGS="/data/adb/sshcustom/settings.ini"
PROPFILE="${module_prop:-/data/adb/modules/sshcustom-vpnchain/module.prop}"

# ── set_description ────────────────────────────────────────────────────────────
set_description() {
  local status="$1"
  local desc
  case "${status}" in
    running) desc="[ 🟢 ] SSHCustom-VPNChain running | mode=${network_mode}" ;;
    stopped) desc="[ 🔴 ] SSHCustom-VPNChain stopped" ;;
    error)   desc="[ ⚠️ ] SSHCustom-VPNChain error — check log" ;;
    *)       desc="[ 💤 ] SSHCustom-VPNChain unknown" ;;
  esac
  [ -f "${PROPFILE}" ] && \
    sed -i "s|^description=.*|description=${desc}|" "${PROPFILE}" 2>/dev/null || true
}

# ── PID helpers ────────────────────────────────────────────────────────────────
bin_alive() {
  local PID
  PID="$(cat "${box_pid}" 2>/dev/null)"
  [ -n "${PID}" ] && kill -0 "${PID}" 2>/dev/null
}

# ── check_bin ──────────────────────────────────────────────────────────────────
check_bin() {
  if [ ! -x "${BIN}" ]; then
    log Error "service: binary not found or not executable: ${BIN}"
    log Error "service: flash the module ZIP to install binaries"
    set_description error
    return 1
  fi
  local ver
  ver="$("${BIN}" version 2>/dev/null || true)"
  log Info "service: ${ver:-sshcustomd (version unknown)}"
}

# ── start_daemon ───────────────────────────────────────────────────────────────
start_daemon() {
  local idle_flag="${1:-}"

  check_bin || return 1

  # Kill any stale instance
  if bin_alive; then
    log Warning "service: daemon already running (pid=$(cat "${box_pid}" 2>/dev/null))"
    return 0
  fi
  rm -f "${box_pid}"
  killall sshcustomd 2>/dev/null || true
  sleep 1

  : > "${box_log}"
  printf '%s service starting...\n' "$(date '+%Y-%m-%d %H:%M:%S')" >> "${box_log}"

  # Apply speed boost before start
  "${scripts_dir}/ssh.tool" speed_boost >> "${box_log}" 2>&1 || true

  local flags="-c ${SETTINGS} -w ${box_dir}"
  [ "${idle_flag}" = "--idle" ] && flags="${flags} --idle"

  nohup "${BIN}" run ${flags} >> "${box_log}" 2>&1 &
  local PID="$!"
  printf '%s\n' "${PID}" > "${box_pid}"
  log Info "service: daemon started pid=${PID} flags=${flags}"

  # Wait up to 5s for API to respond
  local i=0
  while [ "${i}" -lt 5 ]; do
    if bin_alive; then
      if command -v curl >/dev/null 2>&1; then
        curl -fsS --max-time 1 "http://127.0.0.1:9190/api/v1/health" >/dev/null 2>&1 && {
          log Info "service: API ready"
          return 0
        }
      fi
    else
      log Error "service: daemon exited during startup — check ${box_log}"
      rm -f "${box_pid}"
      return 1
    fi
    sleep 1; i=$((i+1))
  done

  bin_alive && log Info "service: daemon running (API still warming up)" && return 0
  log Error "service: daemon failed to start"
  rm -f "${box_pid}"
  return 1
}

# ── start_service ──────────────────────────────────────────────────────────────
start_service() {
  log Info "service: starting SSHCustom-VPNChain..."
  printf '服务正在启动，请稍候...\n'

  mkdir -p "${box_run}" "${box_run_state}" >/dev/null 2>&1 || true

  start_daemon || { set_description error; return 1; }

  # Apply cgroup blkio
  "${scripts_dir}/ssh.tool" blkio >> "${box_log}" 2>&1 || true

  # Apply iptables rules
  "${scripts_dir}/ssh.iptables" enable >> "${box_log}" 2>&1 || {
    log Error "service: iptables enable failed"
    set_description error
    return 1
  }

  set_description running
  log Info "service: started successfully"
}

# ── stop_service ───────────────────────────────────────────────────────────────
stop_service() {
  log Info "service: stopping SSHCustom-VPNChain..."
  printf '服务正在关闭...\n'

  # Disable iptables rules first (loads runtime snapshot for targeted cleanup)
  "${scripts_dir}/ssh.iptables" disable >> "${box_log}" 2>&1 || true

  # Kill daemon
  local PID
  PID="$(cat "${box_pid}" 2>/dev/null)"
  if [ -n "${PID}" ] && kill -0 "${PID}" 2>/dev/null; then
    log Info "service: stopping daemon pid=${PID}"
    kill -TERM "${PID}" 2>/dev/null
    local i=0
    while [ "${i}" -lt 5 ]; do
      kill -0 "${PID}" 2>/dev/null || break
      sleep 1; i=$((i+1))
    done
    kill -0 "${PID}" 2>/dev/null && kill -KILL "${PID}" 2>/dev/null || true
  fi
  killall sshcustomd 2>/dev/null || true
  rm -f "${box_pid}"

  # Restore speed settings
  "${scripts_dir}/ssh.tool" speed_restore >> "${box_log}" 2>&1 || true

  set_description stopped
  log Info "service: stopped — device in clean state"
}

# ── status ─────────────────────────────────────────────────────────────────────
status_service() {
  if bin_alive; then
    local PID
    PID="$(cat "${box_pid}" 2>/dev/null)"
    local rss="$(busybox awk '/VmRSS/{print $2}' /proc/"${PID}"/status 2>/dev/null || echo 0)"
    [ "${rss}" -ge 1024 ] 2>/dev/null && rss="$((rss / 1024)) MB" || rss="${rss} KB"
    log Info "service: running pid=${PID} mem=${rss} mode=${network_mode}"
    return 0
  else
    log Warning "service: stopped"
    return 1
  fi
}

# ── Main ───────────────────────────────────────────────────────────────────────
case "${1:-}" in
  start)        start_service ;;
  start-idle)   start_daemon --idle ;;
  stop)         stop_service ;;
  restart)
    stop_service
    sleep 2
    start_service
    ;;
  status)       status_service ;;
  *)
    printf 'Usage: %s {start|start-idle|stop|restart|status}\n' "$0" >&2
    exit 1
    ;;
esac
